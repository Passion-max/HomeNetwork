# Copy this file to ".env" and fill in your real values.
# .env is git-ignored and never leaves this machine.

# --- Router (required) ------------------------------------------------------
ROUTER_HOST=192.168.1.1
ROUTER_USERNAME=user
ROUTER_PASSWORD=your-admin-password-here

# --- Login (optional; auth is OFF until both hash + secret are set) ---------
# Generate these with:  npm run set-password -- 'your-password'
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=scrypt$...$...
# SESSION_SECRET=<random hex>
# AUTH_SECURE_COOKIE=1          # set when served over HTTPS (hosted)

# --- Cloud mirror / hosted site (optional; sync is OFF until all 3 are set) --
# See docs/HOSTING.md. The collector pushes a copy to Supabase; SQLite stays primary.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key — keep secret, collector only>
# HOME_ID=home-1
# STORE=cloud                   # set ONLY on the hosted reader, never on the home collector
